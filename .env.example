# Optional local configuration for tabular-mlops-lab.
# Copy to .env only if you want to override defaults.

MLOPS_RANDOM_STATE=42
MLOPS_TEST_SIZE=0.2
MLOPS_N_ESTIMATORS=200
MLOPS_MIN_ACCURACY=0.9
MLOPS_MIN_F1=0.9
MLOPS_MIN_ROC_AUC=0.9
MLFLOW_EXPERIMENT_NAME=tabular-classification
MLFLOW_TRACKING_URI=file://./mlruns
MLFLOW_REGISTERED_MODEL_NAME=tabular-mlops-classifier
MLFLOW_MODEL_ALIAS=champion
MODEL_PATH=models/latest/model.skops
LOG_LEVEL=INFO
